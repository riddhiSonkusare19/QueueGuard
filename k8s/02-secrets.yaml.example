# Copy this to 02-secrets.yaml, fill in real values, and DO NOT commit
# 02-secrets.yaml to git. Values below are placeholders.
#
#   cp 02-secrets.yaml.example 02-secrets.yaml
#   kubectl apply -f 02-secrets.yaml
#
# For a quick demo, base64-encoding the same placeholder values below
# is fine. For anything resembling production, use a proper secrets
# manager (AWS Secrets Manager, Sealed Secrets, etc).

apiVersion: v1
kind: Secret
metadata:
  name: queueguard-secrets
  namespace: queueguard
type: Opaque
stringData:
  POSTGRES_USER: queueguard
  POSTGRES_PASSWORD: change-me
  POSTGRES_DB: queueguard
  RABBITMQ_DEFAULT_USER: guest
  RABBITMQ_DEFAULT_PASS: guest

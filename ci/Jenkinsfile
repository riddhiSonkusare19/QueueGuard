pipeline {
    agent any

    environment {
        SERVICES = 'queue_service booking_service notification_service'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Environment Check') {
            steps {
                bat '''
                    echo ===== QueueGuard Jenkins Environment =====
                    git --version
                    py -3.11 --version
                    docker --version
                    kubectl version --client
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                script {
                    for (svc in env.SERVICES.split(' ')) {
                        dir(svc) {
                            bat '''
                                if not exist .venv (
                                    py -3.11 -m venv .venv
                                )
                                .venv\\Scripts\\python.exe -m pip install -q -r requirements-dev.txt
                                .venv\\Scripts\\python.exe -m pytest tests/test_unit.py -v --junitxml=unit-results.xml
                            '''
                        }
                    }
                }
            }
            post {
                always {
                    junit '**/unit-results.xml'
                }
            }
        }

        stage('Integration Tests') {
            steps {
                bat 'docker compose up -d postgres redis rabbitmq'
                bat 'timeout /t 10 /nobreak'

                script {
                    for (svc in env.SERVICES.split(' ')) {
                        dir(svc) {
                            bat '''
                                .venv\\Scripts\\python.exe -m pytest tests/test_integration.py -m integration -v --junitxml=integration-results.xml
                            '''
                        }
                    }
                }
            }
            post {
                always {
                    junit '**/integration-results.xml'
                    bat 'docker compose down -v'
                }
            }
        }

        stage('Coverage Report') {
            steps {
                script {
                    for (svc in env.SERVICES.split(' ')) {
                        dir(svc) {
                            bat '''
                                .venv\\Scripts\\python.exe -m pytest --cov=app --cov-report=xml:coverage.xml --cov-report=html tests/test_unit.py
                            '''
                        }
                    }
                }
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'booking_service/htmlcov',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report (booking_service)'
                    ])
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    for (svc in env.SERVICES.split(' ')) {
                        def imageName = svc.replace('_', '-')
                        bat "docker build -t queueguard-${imageName}:jenkins ${svc}"
                    }
                }
                bat 'docker compose up -d'
            }
        }
        stage('Smoke Test') {
            steps {
                bat '''
                    echo ===== QueueGuard Smoke Test =====

                    echo Checking queue service...
                    curl.exe -f http://localhost:8001/health/live

                    echo.
                    echo Checking booking service...
                    curl.exe -f http://localhost:8002/health/live

                    echo.
                    echo ===== Smoke Test Passed =====
                '''
            }
        }
    }

    post {
        success {
            echo 'QueueGuard local CI pipeline completed successfully.'
        }
        failure {
            echo 'QueueGuard CI pipeline failed. Check the failed stage above.'
        }
        always {
            bat 'docker compose down -v'
        }
    }
}






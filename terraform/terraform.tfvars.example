# cp terraform.tfvars.example terraform.tfvars
# then edit as needed - terraform.tfvars is gitignored, never commit it
# if you put real account-specific values in it.

aws_region          = "us-east-1"
project_name        = "queueguard"
node_instance_type  = "t3.small"   # free-tier eligible is t3.micro/t2.micro, but that's tight for 2 pods + system daemonsets - t3.small is the safe minimum
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3
